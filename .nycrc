{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "check-coverage": true,
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/test/**/*.ts",
    "src/media/**",
    "out/**"
  ],
  "reporter": [
    "html",
    "text",
    "lcov"
  ],
  "statements": 95,
  "branches": 95,
  "functions": 95,
  "lines": 95
}
