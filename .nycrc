{
  "all": true,
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/test/**",
    "src/media/**"
  ],
  "extension": [
    ".ts"
  ],
  "reporter": [
    "text",
    "lcov"
  ],
  "branches": 80,
  "lines": 80,
  "functions": 80,
  "statements": 80,
  "require": [
    "ts-node/register"
  ]
}
