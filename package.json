{
  "name": "jules-extension-vscode",
  "displayName": "Jules – AI Coding Agent",
  "description": "Use Google Jules AI coding agent directly inside VS Code",
  "version": "0.1.0",
  "type": "module",
  "publisher": "juninmd",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "jules",
    "google",
    "ai",
    "coding",
    "assistant"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/juninmd/jules-extension-vscode"
  },
  "license": "MIT",
  "activationEvents": [
    "onStartupFinished",
    "onView:jules.chatView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jules",
          "title": "Jules AI",
          "icon": "media/jules-icon.svg"
        }
      ]
    },
    "views": {
      "jules": [
        {
          "type": "webview",
          "id": "jules.chatView",
          "name": "Jules AI Agent",
          "contextualTitle": "Jules AI"
        }
      ]
    },
    "commands": [
      {
        "command": "jules.openPanel",
        "title": "Open Jules Panel",
        "category": "Jules"
      },
      {
        "command": "jules.configureApiKey",
        "title": "Configure API Key",
        "category": "Jules"
      },
      {
        "command": "jules.newTask",
        "title": "New Task",
        "category": "Jules"
      },
      {
        "command": "jules.clearChat",
        "title": "Clear Chat",
        "category": "Jules"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "jules.openPanel",
          "when": "true"
        },
        {
          "command": "jules.configureApiKey",
          "when": "true"
        },
        {
          "command": "jules.newTask",
          "when": "true"
        },
        {
          "command": "jules.clearChat",
          "when": "true"
        }
      ],
      "editor/context": [
        {
          "command": "jules.newTask",
          "group": "jules",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Jules AI",
      "properties": {
        "jules.apiBaseUrl": {
          "type": "string",
          "default": "https://jules.googleapis.com/v1alpha",
          "description": "Jules API base URL (advanced)",
          "scope": "application"
        },
        "jules.autoOpenOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open the Jules panel when VS Code starts",
          "scope": "window"
        },
        "jules.language": {
          "type": "string",
          "default": "en",
          "enum": [
            "en",
            "pt-BR",
            "es",
            "fr",
            "de",
            "ja",
            "ko",
            "zh-CN"
          ],
          "enumDescriptions": [
            "English",
            "Português (Brasil)",
            "Español",
            "Français",
            "Deutsch",
            "日本語",
            "한국어",
            "中文(简体)"
          ],
          "description": "Display language for the Jules interface",
          "scope": "application"
        }
      }
    },
    "keybindings": [
      {
        "command": "jules.openPanel",
        "key": "ctrl+shift+j",
        "mac": "cmd+shift+j"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && cpx \"media/**/*.{png,svg,css}\" out/media/",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:vscode": "node ./out/test/runTests.js",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/ui": "^4.1.5",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^3.9.1",
    "cpx": "^1.5.0",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
